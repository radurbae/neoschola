# Environment Mode
NODE_ENV=production
PORT=3001

# Storage
DATABASE_PATH=/data/neoschola.sqlite

# Security (Minimal 32 karakter untuk production)
JWT_SECRET=ganti-dengan-kunci-rahasia-jwt-minimal-32-karakter-acak

# CORS (pisahkan dengan koma jika multiple origin, misalnya jika landing page di-host pada domain berbeda)
CORS_ORIGIN=https://neoschola.floc.site

# Seed Data (set "false" untuk disable auto-seed saat startup)
SEED_DEMO_DATA=true

# Demo Reset Guard
ALLOW_DEMO_RESET=false
